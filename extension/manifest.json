{
  "manifest_version": 3,
  "name": "ContactHarvest",
  "short_name": "ContactHarvest",
  "description": "تصدير الأرقام اللي اتراسلت معاها على واتساب ويب لشيت إكسيل بالاسم ورقم التليفون. تطوير: محمد صبري | Mohamed Sabry",
  "version": "1.4.0",
  "author": "محمد صبري | Mohamed Sabry",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ContactHarvest — تصدير جهات واتساب",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
